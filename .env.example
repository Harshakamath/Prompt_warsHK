# LabLink — Environment Variables
# Copy this file to `.env` and fill in your values before running locally.
# NEVER commit a filled-in .env file to version control.

# App identity
VITE_APP_NAME=LabLink
VITE_APP_VERSION=1.0.0

# Firebase configuration (required for Firebase Hosting & Analytics)
# Obtain from Firebase Console → Project Settings → Your Apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Feature flags (optional)
VITE_ENABLE_ANALYTICS=false
